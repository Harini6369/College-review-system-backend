# Application
NODE_ENV=development
PORT=5000

# MongoDB connection string. Use a dedicated database in every environment.
MONGODB_URI=mongodb://127.0.0.1:27017/college_reviews

# JWT signing secret. Use a long random value in every deployed environment.
# Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# Password hashing cost. 12 is a reasonable default for production.
BCRYPT_SALT_ROUNDS=12

# Comma-separated origins, or * for local development.
CORS_ORIGIN=*

# Authentication rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Initial admin account used by `npm run seed`. Placeholder values only.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123

# Sample accounts created by the seed script. Placeholder values only.
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=Teacher123
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=Student123
SEED_STUDENT_TWO_EMAIL=student2@example.com
SEED_STUDENT_TWO_PASSWORD=Student123
